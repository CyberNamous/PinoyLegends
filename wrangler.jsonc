{
  "name": "pinoylegends",
  "pages_build_output_dir": "./",
  "compatibility_date": "2025-10-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "pinoylegends-db", "database_id": "da9fb20a-12ea-42c2-b335-03c19d80d8f3" }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "pinoylegends-images" }
  ],
  // Fill these in after you create the Access application (identifiers, not passwords).
  // Until both are set, every admin request is refused.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
